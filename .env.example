# ==============================================================================
# BIẾN MÔI TRƯỜNG DỰ ÁN TRỌ THÁI NGUYÊN (ENVIRONMENT TEMPLATE)
# ==============================================================================

# Thiết lập chế độ dữ liệu:
# true = Chạy dữ liệu mẫu kiểm thử offline (Mock Store qua LocalStorage)
# false = Kết nối trực tiếp máy chủ REST API / Supabase thật
VITE_USE_MOCK_DATA=true

# Địa chỉ REST API của backend (chỉ cấu hình khi backend đã chạy)
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Nếu backend dùng Supabase/PostgreSQL, đặt credentials riêng ở máy chủ backend.
# Không đưa service-role key hoặc mật khẩu database vào biến VITE_*.

# Cấu hình Google Maps / OpenStreetMap Leaflet Tile
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# Tên ứng dụng & Định danh
VITE_APP_TITLE="Trọ Thái Nguyên - Cổng phòng trọ chính chủ số 1 Thái Nguyên"
VITE_CONTACT_HOTLINE=0988123456
VITE_CONTACT_ZALO=0988123456
VITE_CONTACT_EMAIL=hotro@trothainguyen.vn
